CONTAINER Ocenterbend
{
    INCLUDE Obase;
    NAME Ocenterbend;
    GROUP ID_OBJECTPROPERTIES
    {
        BOOL CB_AUTOFIT { }
        BUTTON CB_FIT { }
        VECTOR CB_SIZE { UNIT METER; MIN 0.0; }
        LONG CB_MODE { CYCLE { CB_MODE_LIMITED; CB_MODE_UNLIMITED; } }
        REAL CB_ANGLE { UNIT DEGREE; }
        REAL CB_CENTER { UNIT PERCENT; MIN -50.0; MAX 50.0; CUSTOMGUI REALSLIDER; }
        REAL CB_FLAT { UNIT PERCENT; MIN 0.0; MAX 100.0; CUSTOMGUI REALSLIDER; }
        REAL CB_BLEND { UNIT PERCENT; MIN 0.0; MAX 100.0; CUSTOMGUI REALSLIDER; }
        REAL CB_YSHIFT { UNIT METER; }
        LONG CB_YMODE { CYCLE { CB_YMODE_SAME; CB_YMODE_OPPOSITE; } }
    }
}
